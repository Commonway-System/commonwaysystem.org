{
  "name": "commonway-site",
  "type": "module",
  "version": "2026.11.10",
  "private": true,
  "description": "Commonway System Guidebook website, built on SveltePress with a fully custom Commonway theme.",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/stamp-version.mjs && vite build && node scripts/generate-text-pages.mjs && node scripts/generate-agent-files.mjs && node scripts/build-search-index.mjs && node scripts/make-thumbs.mjs --check",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "thumbs": "node scripts/make-thumbs.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@sveltepress/vite": "^1.10.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "d3-geo": "3.1.2",
    "node-html-parser": "^9.0.7",
    "pagefind": "^1.6.0",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "topojson-client": "3.1.0",
    "topojson-simplify": "3.0.3",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^6.0.3",
    "us-atlas": "3.0.1",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  }
}
