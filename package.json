{
  "name": "commonway-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Commonway System Guidebook website, built on SveltePress with a fully custom Commonway theme.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/generate-text-pages.mjs && node scripts/build-search-index.mjs && node scripts/make-thumbs.mjs --check",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "thumbs": "node scripts/make-thumbs.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@sveltepress/vite": "^1.4.1",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@types/turndown": "^5.0.6",
    "node-html-parser": "^9.0.4",
    "pagefind": "^1.5.2",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.4",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  }
}
